# Environment variables for a Railway (or any container) deployment.
# Set these in the Railway service "Variables" tab - do NOT commit a real .env.

# ---- LLM (optional but recommended) ----------------------------------------
# Free key: https://console.groq.com  -> powers match reconciliation + the
# "read each sheet / draft the findings" workbook passes.
GROQ_API_KEY=
# LLM_PROVIDER=auto            # auto | groq | openai | anthropic | off
# LLM_MODEL=                   # blank = provider default (groq: llama-3.3-70b-versatile)
# LLM_WORKBOOK=true

# ---- Persistence ----------------------------------------------------------
# Point at a mounted Railway Volume so the learning store + generated files
# survive redeploys. Without a volume the app still runs (ephemeral storage).
STORAGE_DIR=/data

# ---- Misc ---------------------------------------------------------------
# RAILWAY_PUBLIC_DOMAIN is injected by Railway automatically.
# MAX_UPLOAD_MB=50
# ALLOW_LOCAL_SAMPLES=true     # "Load bundled samples" for the two demo xlsx
# ALLOWED_ORIGINS=             # only needed if the frontend is hosted separately
