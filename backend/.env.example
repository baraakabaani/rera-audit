# Copy to .env to override defaults. All values are optional.

# --- LLM (optional) ------------------------------------------------------
# Powers (a) match reconciliation and (b) the "read each sheet, write the
# exact cells" workbook-mapping pass. Everything works offline without it.
# Provide ONE of the following:
#
#   Groq  - FREE, fast, OpenAI-compatible  (get a key at console.groq.com)
GROQ_API_KEY=
#   OpenAI or any OpenAI-compatible endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.together.xyz/v1
#   Anthropic (or an `ant auth login` profile)
# ANTHROPIC_API_KEY=sk-ant-...
#
LLM_ENABLED=true
LLM_PROVIDER=auto            # auto | groq | openai | anthropic | off
LLM_MODEL=                   # blank = provider default (groq: llama-3.3-70b-versatile)
LLM_WORKBOOK=true            # let the LLM map the annexure sheets

# --- CORS ----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Local sample data (developer convenience) --------------------------
ALLOW_LOCAL_SAMPLES=true
# SAMPLE_REQUIREMENTS=C:\Users\baraa\Desktop\rera site\OA_DLD_RERA_Interim Audit_Requirements_PROA_30 June 2026.xlsx
# SAMPLE_TEMPLATE=C:\Users\baraa\Desktop\rera site\template.xlsx
# SAMPLE_DOCUMENTS_DIR=C:\Users\baraa\Desktop\rerea\annual interm documents

# --- Uploads -----------------------------------------------------------
MAX_UPLOAD_MB=50
